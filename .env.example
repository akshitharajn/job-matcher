# Set these as environment variables (the app does not read this file by itself).
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# fastembed = real embeddings; hashing = no model download (tests/offline)
EMBEDDER=fastembed
# Live job feeds
LIVE_JOBS=1
JOB_REFRESH_HOURS=6
MAX_LIVE_JOBS=200
RATE_LIMIT_PER_MIN=20
